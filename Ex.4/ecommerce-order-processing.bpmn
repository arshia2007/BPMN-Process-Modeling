    <bpmn:sequenceFlow id="Flow_11eduhc" sourceRef="Gateway_0m5vql9" targetRef="Activity_1p3pomb">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewDecision = "APPROVE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_05z6noq" name="Order Completed">
