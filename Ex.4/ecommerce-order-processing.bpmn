  <bpmn:process id="Process_1qnj4eq" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Customer submits order">
      <bpmn:outgoing>Flow_1nupwiz</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1nupwiz" sourceRef="StartEvent_1" targetRef="Activity_1tuidrq" />
    <bpmn:serviceTask id="Activity_1tuidrq" name="Validate Order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1nupwiz</bpmn:incoming>
      <bpmn:outgoing>Flow_1ki2qii</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0zonsdd" name="Is order valid?" default="Flow_1mc578v">
      <bpmn:incoming>Flow_1ki2qii</bpmn:incoming>
      <bpmn:outgoing>Flow_0a9gixa</bpmn:outgoing>
      <bpmn:outgoing>Flow_1mc578v</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1ki2qii" sourceRef="Activity_1tuidrq" targetRef="Gateway_0zonsdd" />
    <bpmn:serviceTask id="Activity_0l7asj9" name="Check Inventory">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-inventory" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0a9gixa</bpmn:incoming>
      <bpmn:outgoing>Flow_1gt3ubu</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0a9gixa" sourceRef="Gateway_0zonsdd" targetRef="Activity_0l7asj9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_1idcd1w" name="Is stock available?" default="Flow_0ndf1tf">
      <bpmn:incoming>Flow_1gt3ubu</bpmn:incoming>
      <bpmn:outgoing>Flow_0npgabo</bpmn:outgoing>
      <bpmn:outgoing>Flow_0ndf1tf</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1gt3ubu" sourceRef="Activity_0l7asj9" targetRef="Gateway_1idcd1w" />
    <bpmn:businessRuleTask id="Activity_0zbxnag" name="Determine Priority">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="order_priority" resultVariable="deliveryPriority" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0npgabo</bpmn:incoming>
      <bpmn:outgoing>Flow_05t233o</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_0npgabo" sourceRef="Gateway_1idcd1w" targetRef="Activity_0zbxnag">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_01r5qp9" name="Process Payment" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://localhost:8085/api/payment" target="url" />
          <zeebe:input source="={&#10;  &#34;Content-Type&#34;: &#34;application/json&#34;&#10;}&#10;" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="= {&#10;  customerRef: customerRef,&#10;  orderTotal: orderTotal,&#10;  paymentToken: paymentToken&#10;}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultVariable" />
          <zeebe:header key="resultExpression" value="=&#10;{&#10;  paymentStatus: response.body.paymentStatus&#10;}&#10;  " />
          <zeebe:header key="errorExpression" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05t233o</bpmn:incoming>
      <bpmn:outgoing>Flow_1y4fhct</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_05t233o" sourceRef="Activity_0zbxnag" targetRef="Activity_01r5qp9" />
    <bpmn:exclusiveGateway id="Gateway_06aj83h" name="Payment approved?" default="Flow_00wg4yy">
      <bpmn:incoming>Flow_1y4fhct</bpmn:incoming>
      <bpmn:outgoing>Flow_00wg4yy</bpmn:outgoing>
      <bpmn:outgoing>Flow_07pi88x</bpmn:outgoing>
