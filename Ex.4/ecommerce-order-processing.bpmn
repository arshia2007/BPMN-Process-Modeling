    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_00wg4yy" sourceRef="Gateway_06aj83h" targetRef="Event_1w1amko" />
    <bpmn:exclusiveGateway id="Gateway_09paz9j" name="High-value order?" default="Flow_035vs82">
      <bpmn:incoming>Flow_07pi88x</bpmn:incoming>
      <bpmn:outgoing>Flow_0rxbxty</bpmn:outgoing>
      <bpmn:outgoing>Flow_035vs82</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_07pi88x" sourceRef="Gateway_06aj83h" targetRef="Gateway_09paz9j">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_1p4fan2" name="Manual Verification">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="order-review-form" />
        <zeebe:assignmentDefinition candidateGroups="reviewers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0rxbxty</bpmn:incoming>
      <bpmn:outgoing>Flow_1xis5pd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0rxbxty" sourceRef="Gateway_09paz9j" targetRef="Activity_1p4fan2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderTotal &gt;= 20000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0m5vql9" name="Review Approved?" default="Flow_0wwmzu5">
      <bpmn:incoming>Flow_1xis5pd</bpmn:incoming>
      <bpmn:outgoing>Flow_0wwmzu5</bpmn:outgoing>
      <bpmn:outgoing>Flow_11eduhc</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1xis5pd" sourceRef="Activity_1p4fan2" targetRef="Gateway_0m5vql9" />
    <bpmn:endEvent id="Event_17oww4j" name="Review Rejected">
      <bpmn:incoming>Flow_0wwmzu5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0wwmzu5" sourceRef="Gateway_0m5vql9" targetRef="Event_17oww4j" />
    <bpmn:serviceTask id="Activity_1p3pomb" name="Fulfil Order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fulfil-order" />
      </bpmn:extensionElements>
